<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion - Suivi des visites magasin</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
    }

    .container {
      width: 90%;
      max-width: 450px;
      margin: 80px auto;
      padding: 30px;
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
      text-align: center;
    }

    h1 {
      margin-bottom: 10px;
      color: #2453d4;
    }

    p {
      color: #6b7280;
      margin-bottom: 25px;
    }

    input,
    button {
      width: 100%;
      padding: 14px;
      margin-top: 12px;
      border-radius: 7px;
      font-size: 16px;
    }

    input {
      border: 1px solid #cbd5e1;
    }

    button {
      border: none;
      background: #2453d4;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #193fa8;
    }

    .message {
      margin-top: 15px;
      color: #dc2626;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <main class="container">
    <h1>Suivi des visites magasin</h1>
    <p>Connectez-vous à votre espace</p>

    <form id="loginForm">
      <input
        type="email"
        id="email"
        placeholder="Adresse e-mail"
        required
      >

      <input
        type="password"
        id="password"
        placeholder="Mot de passe"
        required
      >

      <button type="submit">Se connecter</button>
    </form>

    <div id="message" class="message"></div>
  </main>

  <script>
    const utilisateurs = {
      "dr@test.com": {
        motDePasse: "1234",
        role: "DR",
        nom: "Direction Régionale"
      },
      "rov@test.com": {
        motDePasse: "1234",
        role: "ROV",
        nom: "Responsable Opérationnel Vente"
      },
      "rsr@test.com": {
        motDePasse: "1234",
        role: "RSR",
        nom: "Responsable Service et Pose"
      },
      "rrh@test.com": {
        motDePasse: "1234",
        role: "RRH",
        nom: "Responsable Ressources Humaines"
      }
    };

    document
      .getElementById("loginForm")
      .addEventListener("submit", function(event) {
        event.preventDefault();

        const email = document
          .getElementById("email")
          .value
          .trim()
          .toLowerCase();

        const password = document
          .getElementById("password")
          .value;

        const message = document.getElementById("message");
        const utilisateur = utilisateurs[email];

        if (!utilisateur || utilisateur.motDePasse !== password) {
          message.textContent = "Adresse e-mail ou mot de passe incorrect.";
          return;
        }

        localStorage.setItem(
          "utilisateurConnecte",
          JSON.stringify({
            email: email,
            nom: utilisateur.nom,
            role: utilisateur.role
          })
        );

        window.location.href = "dashboard.html";
      });
  </script>

</body>
</html>

